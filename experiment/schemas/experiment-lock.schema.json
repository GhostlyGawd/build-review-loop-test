{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/experiment-lock.schema.json",
  "title": "Protocol 2.4.0-draft provisional experiment lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "protocolStatus",
    "supersedesLockCommit",
    "lockParentCommit",
    "hiddenSuiteId",
    "hiddenSuiteSha256",
    "treatmentSkillCommit",
    "treatmentSkillTree",
    "treatmentSkillManifestSha256",
    "treatmentAlgorithmSha256",
    "neutralBuilderPromptSha256",
    "neutralBuilderConfigSha256",
    "cliBinaryPath",
    "cliVersion",
    "cliBinarySha256",
    "cliAuthStatus",
    "cliRuntimeSchemaSha256",
    "cliRunnerSha256",
    "roleRuntimeSchemaSha256",
    "roleRunnerSha256",
    "supervisionEvidenceSchemaSha256",
    "reviewerPromptTemplateSha256",
    "fixerPromptTemplateSha256",
    "testerPromptTemplateSha256",
    "evaluatorPromptTemplateSha256",
    "reviewArtifactSchemaSha256",
    "fixArtifactSchemaSha256",
    "testArtifactSchemaSha256",
    "evaluationArtifactSchemaSha256",
    "rubricSha256",
    "frozenGateSetSha256",
    "blindedPackageSchemaSha256",
    "blindedPackageScriptSha256",
    "v4SmokeContractSha256",
    "v4SmokeSupervisorSha256",
    "v4SmokeSupervisionSha256",
    "v4SmokePromptSha256",
    "runnerSmokeContractSha256",
    "runnerSmokeSupervisionSha256",
    "runnerSmokeAttestationSha256",
    "canonicalContractSha256",
    "goldenFixtureSha256",
    "invalidCurrentFixtureSha256",
    "commonStartCommitPolicy",
    "nodeVersion",
    "packageManager",
    "freezeState"
  ],
  "properties": {
    "protocolVersion": { "const": "2.4.0-draft" },
    "protocolStatus": { "const": "provisional" },
    "supersedesLockCommit": { "$ref": "#/$defs/sha1" },
    "lockParentCommit": { "type": "null" },
    "hiddenSuiteId": { "const": "permissions-playground-sealed-v2" },
    "hiddenSuiteSha256": { "$ref": "#/$defs/sha256" },
    "treatmentSkillCommit": { "type": "null" },
    "treatmentSkillTree": { "type": "null" },
    "treatmentSkillManifestSha256": { "type": "null" },
    "treatmentAlgorithmSha256": { "$ref": "#/$defs/sha256" },
    "neutralBuilderPromptSha256": { "$ref": "#/$defs/sha256" },
    "neutralBuilderConfigSha256": { "$ref": "#/$defs/sha256" },
    "cliBinaryPath": {
      "const": "C:\\Users\\rhenm\\.codex\\plugins\\.plugin-appserver\\codex.exe"
    },
    "cliVersion": { "const": "codex-cli 0.145.0-alpha.18" },
    "cliBinarySha256": { "$ref": "#/$defs/sha256" },
    "cliAuthStatus": { "const": "Logged in using ChatGPT" },
    "cliRuntimeSchemaSha256": { "$ref": "#/$defs/sha256" },
    "cliRunnerSha256": { "$ref": "#/$defs/sha256" },
    "roleRuntimeSchemaSha256": { "$ref": "#/$defs/sha256" },
    "roleRunnerSha256": { "$ref": "#/$defs/sha256" },
    "supervisionEvidenceSchemaSha256": { "$ref": "#/$defs/sha256" },
    "reviewerPromptTemplateSha256": { "$ref": "#/$defs/sha256" },
    "fixerPromptTemplateSha256": { "$ref": "#/$defs/sha256" },
    "testerPromptTemplateSha256": { "$ref": "#/$defs/sha256" },
    "evaluatorPromptTemplateSha256": { "$ref": "#/$defs/sha256" },
    "reviewArtifactSchemaSha256": { "$ref": "#/$defs/sha256" },
    "fixArtifactSchemaSha256": { "$ref": "#/$defs/sha256" },
    "testArtifactSchemaSha256": { "$ref": "#/$defs/sha256" },
    "evaluationArtifactSchemaSha256": { "$ref": "#/$defs/sha256" },
    "rubricSha256": { "$ref": "#/$defs/sha256" },
    "frozenGateSetSha256": { "$ref": "#/$defs/sha256" },
    "blindedPackageSchemaSha256": { "$ref": "#/$defs/sha256" },
    "blindedPackageScriptSha256": { "$ref": "#/$defs/sha256" },
    "v4SmokeContractSha256": { "$ref": "#/$defs/sha256" },
    "v4SmokeSupervisorSha256": { "$ref": "#/$defs/sha256" },
    "v4SmokeSupervisionSha256": { "$ref": "#/$defs/sha256" },
    "v4SmokePromptSha256": { "$ref": "#/$defs/sha256" },
    "runnerSmokeContractSha256": { "type": "null" },
    "runnerSmokeSupervisionSha256": { "type": "null" },
    "runnerSmokeAttestationSha256": { "type": "null" },
    "canonicalContractSha256": { "$ref": "#/$defs/sha256" },
    "goldenFixtureSha256": { "$ref": "#/$defs/sha256" },
    "invalidCurrentFixtureSha256": { "$ref": "#/$defs/sha256" },
    "commonStartCommitPolicy": { "type": "string", "minLength": 1 },
    "nodeVersion": { "const": "22.x" },
    "packageManager": { "const": "npm@11.11.0" },
    "freezeState": { "const": "provisional" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
