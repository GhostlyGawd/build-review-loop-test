{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/experiment-lock.schema.json",
  "title": "Protocol 2.1.0 experiment lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "protocolStatus",
    "supersedesLockCommit",
    "lockParentCommit",
    "hiddenSuiteId",
    "hiddenSuiteSha256",
    "treatmentSkillCommit",
    "treatmentSkillTree",
    "treatmentSkillManifestSha256",
    "treatmentAlgorithmSha256",
    "neutralBuilderPromptSha256",
    "neutralBuilderConfigSha256",
    "canonicalContractSha256",
    "goldenFixtureSha256",
    "commonStartCommitPolicy",
    "nodeVersion",
    "packageManager",
    "freezeState"
  ],
  "properties": {
    "protocolVersion": { "const": "2.1.0" },
    "protocolStatus": { "enum": ["draft", "locked"] },
    "supersedesLockCommit": { "$ref": "#/$defs/sha1" },
    "lockParentCommit": { "$ref": "#/$defs/nullableSha1" },
    "hiddenSuiteId": { "const": "permissions-playground-sealed-v2" },
    "hiddenSuiteSha256": { "$ref": "#/$defs/sha256" },
    "treatmentSkillCommit": { "$ref": "#/$defs/nullableSha1" },
    "treatmentSkillTree": { "$ref": "#/$defs/nullableSha1" },
    "treatmentSkillManifestSha256": { "$ref": "#/$defs/nullableSha256" },
    "treatmentAlgorithmSha256": { "$ref": "#/$defs/sha256" },
    "neutralBuilderPromptSha256": { "$ref": "#/$defs/sha256" },
    "neutralBuilderConfigSha256": { "$ref": "#/$defs/sha256" },
    "canonicalContractSha256": { "$ref": "#/$defs/sha256" },
    "goldenFixtureSha256": { "$ref": "#/$defs/nullableSha256" },
    "commonStartCommitPolicy": { "type": "string", "minLength": 1 },
    "nodeVersion": { "const": "22.x" },
    "packageManager": { "const": "npm@11.11.0" },
    "freezeState": { "enum": ["provisional", "frozen"] }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha1": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha1" }]
    },
    "nullableSha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "freezeState": { "const": "provisional" } },
        "required": ["freezeState"]
      },
      "then": {
        "properties": {
          "protocolStatus": { "const": "draft" },
          "lockParentCommit": { "type": "null" },
          "treatmentSkillCommit": { "type": "null" },
          "treatmentSkillTree": { "type": "null" },
          "treatmentSkillManifestSha256": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "freezeState": { "const": "frozen" } },
        "required": ["freezeState"]
      },
      "then": {
        "properties": {
          "protocolStatus": { "const": "locked" },
          "lockParentCommit": { "$ref": "#/$defs/sha1" },
          "treatmentSkillCommit": { "$ref": "#/$defs/sha1" },
          "treatmentSkillTree": { "$ref": "#/$defs/sha1" },
          "treatmentSkillManifestSha256": { "$ref": "#/$defs/sha256" },
          "goldenFixtureSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ]
}
