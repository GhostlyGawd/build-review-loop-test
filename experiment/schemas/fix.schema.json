{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/fix.schema.json",
  "title": "Fix-session record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateLabel",
    "startCommit",
    "finalCommit",
    "startedAt",
    "completedAt",
    "dispositions",
    "changedFiles",
    "checks",
    "remainingDefects",
    "deviations"
  ],
  "properties": {
    "candidateLabel": { "type": "string", "pattern": "^candidate-[a-z0-9-]+$" },
    "startCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "finalCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "decision", "rationale", "evidence"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "decision": {
            "enum": ["accepted", "partially-accepted", "rejected"]
          },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changedFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "remainingDefects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
