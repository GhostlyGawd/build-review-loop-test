{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/review.schema.json",
  "title": "Blinded review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateLabel",
    "snapshotCommit",
    "reviewerId",
    "focus",
    "startedAt",
    "completedAt",
    "checksRun",
    "coverageGaps",
    "findings"
  ],
  "properties": {
    "candidateLabel": { "type": "string", "pattern": "^candidate-[a-z0-9-]+$" },
    "snapshotCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewerId": { "enum": ["F", "Q"] },
    "focus": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "checksRun": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "title",
          "evidence",
          "expected",
          "actual",
          "rubricItems",
          "verification",
          "duplicateOf"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^candidate-[a-z0-9-]+-[FQ]-[0-9]{2}$"
          },
          "severity": { "enum": ["critical", "major", "minor", "note"] },
          "title": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "minLength": 1 },
          "rubricItems": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "A1",
                "A2",
                "A3",
                "A4",
                "A5",
                "A6",
                "A7",
                "B1",
                "B2",
                "B3",
                "C1",
                "C2",
                "C3",
                "D1",
                "D2",
                "D3",
                "E1",
                "E2",
                "E3",
                "E4"
              ]
            }
          },
          "verification": { "type": "string", "minLength": 1 },
          "duplicateOf": { "type": ["string", "null"] }
        }
      }
    }
  }
}
