{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/review.schema.json",
  "title": "Fresh treatment-cycle review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateLabel",
    "cycle",
    "snapshotCommit",
    "roleInstanceId",
    "startedAt",
    "completedAt",
    "checksRun",
    "evidenceExamined",
    "coverageGaps",
    "findings"
  ],
  "properties": {
    "candidateLabel": { "type": "string", "pattern": "^candidate-[a-z0-9-]+$" },
    "cycle": { "type": "integer", "minimum": 1, "maximum": 5 },
    "snapshotCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "roleInstanceId": { "type": "string", "pattern": "^cycle-[1-5]-reviewer$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "checksRun": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceExamined": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "https://ghostlygawd.example/schemas/finding.schema.json"
      }
    }
  }
}
