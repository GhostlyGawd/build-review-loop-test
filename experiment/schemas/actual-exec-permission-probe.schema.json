{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/actual-exec-permission-probe.schema.json",
  "title": "Protocol 2.7 actual Codex exec permission probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "probeVersion",
    "executedAt",
    "completedAt",
    "actualModelCall",
    "harmlessPrompt",
    "candidateContentExposed",
    "approvalPolicy",
    "sandboxMode",
    "windowsSandbox",
    "networkEnabled",
    "ignoreUserConfig",
    "ignoreRules",
    "cliVersion",
    "cliSha256",
    "model",
    "reasoningEffort",
    "promptSha256",
    "invariantArgv",
    "environmentKeys",
    "addDirRoles",
    "parentCommit",
    "parentTree",
    "exitCode",
    "rawJsonlValid",
    "threadCount",
    "turnCompleted",
    "ordinaryWorkspaceWrite",
    "addDirWrites",
    "gitNodeNpm",
    "gitMetadataUnchangedBeforeSupervisor",
    "privateCanaryUnchanged",
    "outsideCanaryUnchanged",
    "supervisorCommit",
    "supervisorCommitExactlyOneChild",
    "supervisorCommitClean",
    "hooksDisabled",
    "valid"
  ],
  "properties": {
    "protocolVersion": { "const": "2.7.0" },
    "probeVersion": { "const": "2.0.0" },
    "executedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "actualModelCall": { "const": true },
    "harmlessPrompt": { "const": true },
    "candidateContentExposed": { "const": false },
    "approvalPolicy": { "const": "never" },
    "sandboxMode": { "const": "workspace-write" },
    "windowsSandbox": { "const": "elevated" },
    "networkEnabled": { "const": false },
    "ignoreUserConfig": { "const": true },
    "ignoreRules": { "const": true },
    "cliVersion": { "const": "codex-cli 0.145.0-alpha.18" },
    "cliSha256": { "$ref": "#/$defs/sha256" },
    "model": { "const": "gpt-5.4" },
    "reasoningEffort": { "const": "xhigh" },
    "promptSha256": { "$ref": "#/$defs/sha256" },
    "invariantArgv": {
      "const": [
        "-a",
        "never",
        "-m",
        "gpt-5.4",
        "-c",
        "model_reasoning_effort=\"xhigh\"",
        "-c",
        "windows.sandbox=\"elevated\"",
        "-c",
        "sandbox_workspace_write.network_access=false",
        "exec",
        "--ephemeral",
        "--ignore-user-config",
        "--ignore-rules",
        "--skip-git-repo-check",
        "--sandbox",
        "workspace-write",
        "--json"
      ]
    },
    "environmentKeys": {
      "const": [
        "TEMP",
        "TMP",
        "NPM_CONFIG_CACHE",
        "CODEX_DEPENDENCY_ROOT",
        "PORT"
      ]
    },
    "addDirRoles": { "const": ["tempRoot", "cacheRoot", "dependencyRoot"] },
    "parentCommit": { "$ref": "#/$defs/sha1" },
    "parentTree": { "$ref": "#/$defs/sha1" },
    "exitCode": { "const": 0 },
    "rawJsonlValid": { "const": true },
    "threadCount": { "const": 1 },
    "turnCompleted": { "const": true },
    "ordinaryWorkspaceWrite": { "const": true },
    "addDirWrites": { "const": true },
    "gitNodeNpm": { "const": true },
    "gitMetadataUnchangedBeforeSupervisor": { "const": true },
    "privateCanaryUnchanged": { "const": true },
    "outsideCanaryUnchanged": { "const": true },
    "supervisorCommit": { "$ref": "#/$defs/sha1" },
    "supervisorCommitExactlyOneChild": { "const": true },
    "supervisorCommitClean": { "const": true },
    "hooksDisabled": { "const": true },
    "valid": { "const": true }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
