{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/final-lock-evidence.schema.json",
  "title": "Protocol 2.8.0 final-lock preflight evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceVersion",
    "supersedesFinalizationCommit",
    "aggregation",
    "protocolParent",
    "treatmentSkill",
    "abortedPrelaunch",
    "permissionProbe",
    "secondaryPermissionProbe",
    "gates",
    "gateAggregateSha256"
  ],
  "properties": {
    "evidenceVersion": { "const": "1.0.0" },
    "supersedesFinalizationCommit": {
      "const": "e2c892e3b88702fcbd9a2049926d4a28b94efa4a"
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "domain",
        "excludedTopLevelProperty"
      ],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "domain": {
          "const": "permissions-playground/protocol-lock-preflight-v1\\u0000"
        },
        "excludedTopLevelProperty": { "const": "gateAggregateSha256" }
      }
    },
    "protocolParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "lockSha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "lockSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "treatmentSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "manifestFile",
        "manifestSha256",
        "manifestEntryCount",
        "manifestCommentLineCount",
        "manifestPhysicalLineCount",
        "manifestByteSource",
        "manifestToolSha256",
        "attributesSha256",
        "sourceParitySha256",
        "sourceParityFileCount",
        "sourceParityAllMatch"
      ],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "manifestFile": { "const": "MANIFEST.sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "manifestEntryCount": { "const": 63 },
        "manifestCommentLineCount": { "const": 3 },
        "manifestPhysicalLineCount": { "const": 66 },
        "manifestByteSource": { "const": "canonical-git-blob" },
        "manifestToolSha256": { "$ref": "#/$defs/sha256" },
        "attributesSha256": { "$ref": "#/$defs/sha256" },
        "sourceParitySha256": { "$ref": "#/$defs/sha256" },
        "sourceParityFileCount": { "const": 50 },
        "sourceParityAllMatch": { "const": true }
      }
    },
    "abortedPrelaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "disposition", "activityCount"],
      "properties": {
        "path": { "const": "experiment/preflight/aborted-lock-2.7.0.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "disposition": { "const": "invalidated-before-assignment" },
        "activityCount": { "const": 2 }
      }
    },
    "permissionProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "scriptSha256",
        "schemaSha256",
        "promptSha256",
        "commitScriptSha256",
        "modelCall",
        "builderPermissionDimensionsMatch",
        "valid"
      ],
      "properties": {
        "path": {
          "const": "experiment/preflight/actual-exec-permission-probe-2.7.0.json"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "scriptSha256": { "$ref": "#/$defs/sha256" },
        "schemaSha256": { "$ref": "#/$defs/sha256" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "commitScriptSha256": { "$ref": "#/$defs/sha256" },
        "modelCall": { "const": true },
        "builderPermissionDimensionsMatch": { "const": true },
        "valid": { "const": true }
      }
    },
    "secondaryPermissionProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "scriptSha256",
        "modelCall",
        "authoritative",
        "valid"
      ],
      "properties": {
        "path": { "const": "experiment/preflight/permission-probe-2.6.0.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "scriptSha256": { "$ref": "#/$defs/sha256" },
        "modelCall": { "const": false },
        "authoritative": { "const": false },
        "valid": { "const": true }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C"],
      "properties": {
        "A": { "$ref": "#/$defs/gate" },
        "B": { "$ref": "#/$defs/gate" },
        "C": { "$ref": "#/$defs/gate" }
      }
    },
    "gateAggregateSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "attestationSha256", "artifacts", "commitments"],
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "attestationSha256": { "$ref": "#/$defs/sha256" },
        "artifacts": { "$ref": "#/$defs/nestedCommitments" },
        "commitments": { "$ref": "#/$defs/nestedCommitments" }
      }
    },
    "nestedCommitments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/sha1" },
          { "$ref": "#/$defs/sha256" },
          { "type": "boolean" },
          { "type": "integer", "minimum": 0 },
          { "$ref": "#/$defs/nestedCommitments" }
        ]
      }
    }
  }
}
