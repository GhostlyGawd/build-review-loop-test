{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/cli-supervision-evidence.schema.json",
  "title": "Protocol 2.4 single CLI supervision evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "invocationId",
    "contractSha256",
    "artifactSchemaSha256",
    "processId",
    "started",
    "startedAt",
    "startError",
    "stdinDelivered",
    "stdinError",
    "exitCode",
    "timedOut",
    "argv",
    "argvSha256",
    "promptSha256",
    "stdoutPath",
    "stdoutSha256",
    "stderrPath",
    "stderrSha256",
    "finalPath",
    "finalSha256",
    "finalSchemaValid",
    "artifactBindingValid",
    "threadIds",
    "turnCompleted",
    "rawJsonlValid",
    "unauthorizedToolOrWriteDetected",
    "unauthorizedToolOrWriteUnavailableReason",
    "sandboxMode",
    "inputDisposition",
    "isolationEnforcedBy",
    "usage",
    "usageUnavailableReason",
    "runtimeModel",
    "runtimeModelUnavailableReason",
    "runtimeProvider",
    "runtimeProviderUnavailableReason",
    "reasoningSetting",
    "reasoningSettingUnavailableReason",
    "metadataSource"
  ],
  "properties": {
    "role": { "enum": ["builder", "reviewer", "fixer", "tester", "evaluator"] },
    "invocationId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "contractSha256": { "$ref": "#/$defs/sha256" },
    "artifactSchemaSha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "processId": { "type": ["integer", "null"], "minimum": 1 },
    "started": { "type": "boolean" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "absoluteDeadline": { "type": "string", "format": "date-time" },
    "startError": { "type": ["string", "null"] },
    "stdinDelivered": { "type": "boolean" },
    "stdinError": { "type": ["string", "null"] },
    "exitCode": { "type": ["integer", "null"] },
    "timedOut": { "type": "boolean" },
    "argv": { "type": "array", "minItems": 15, "items": { "type": "string" } },
    "argvSha256": { "$ref": "#/$defs/sha256" },
    "promptSha256": { "$ref": "#/$defs/sha256" },
    "stdoutPath": { "type": "string", "minLength": 3 },
    "stdoutSha256": { "$ref": "#/$defs/sha256" },
    "stderrPath": { "type": "string", "minLength": 3 },
    "stderrSha256": { "$ref": "#/$defs/sha256" },
    "finalPath": { "type": "string", "minLength": 3 },
    "finalSha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "postStatePath": { "type": "string", "minLength": 3 },
    "postStateSha256": { "$ref": "#/$defs/sha256" },
    "finalSchemaValid": { "type": ["boolean", "null"] },
    "artifactBindingValid": { "type": ["boolean", "null"] },
    "threadIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "turnCompleted": { "type": "boolean" },
    "rawJsonlValid": { "type": "boolean" },
    "unauthorizedToolOrWriteDetected": { "type": ["boolean", "null"] },
    "unauthorizedToolOrWriteUnavailableReason": { "type": ["string", "null"] },
    "sandboxMode": { "enum": ["read-only", "workspace-write"] },
    "inputDisposition": {
      "enum": [
        "read-only-snapshot",
        "authorized-worktree-write",
        "discard-after-run"
      ]
    },
    "isolationEnforcedBy": {
      "const": "audited-procedural-boundary-plus-cli-sandbox"
    },
    "usage": { "type": ["object", "null"] },
    "usageUnavailableReason": { "type": ["string", "null"] },
    "runtimeModel": { "type": ["string", "null"] },
    "runtimeModelUnavailableReason": { "type": ["string", "null"] },
    "runtimeProvider": { "type": ["string", "null"] },
    "runtimeProviderUnavailableReason": { "type": ["string", "null"] },
    "reasoningSetting": { "type": ["string", "null"] },
    "reasoningSettingUnavailableReason": { "type": ["string", "null"] },
    "metadataSource": { "enum": ["trusted-jsonl", "unavailable"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "role": { "const": "builder" } },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "postStatePath": true,
          "postStateSha256": true
        },
        "required": ["postStatePath", "postStateSha256"]
      }
    },
    {
      "if": {
        "properties": { "role": { "not": { "const": "builder" } } },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "completedAt": true,
          "absoluteDeadline": true
        },
        "required": ["completedAt", "absoluteDeadline"]
      }
    }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
