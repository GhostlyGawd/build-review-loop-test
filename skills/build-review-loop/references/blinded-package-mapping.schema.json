{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.example/schemas/blinded-package-mapping.schema.json",
  "title": "Private blinded-package source mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappingSeedSha256",
    "randomizedOrder",
    "frozenGateSetSha256",
    "provenance",
    "packages"
  ],
  "properties": {
    "mappingSeedSha256": { "$ref": "#/$defs/sha256" },
    "randomizedOrder": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["X", "Y", "Z"] }
    },
    "frozenGateSetSha256": { "$ref": "#/$defs/sha256" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateIds",
        "runIds",
        "evidencePaths",
        "roleArtifactNames"
      ],
      "properties": {
        "candidateIds": { "$ref": "#/$defs/nonemptyStrings" },
        "runIds": { "$ref": "#/$defs/nonemptyStrings" },
        "evidencePaths": { "$ref": "#/$defs/nonemptyStrings" },
        "roleArtifactNames": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/package" },
      "allOf": [
        {
          "contains": {
            "properties": { "packageLabel": { "const": "X" } },
            "required": ["packageLabel"]
          }
        },
        {
          "contains": {
            "properties": { "packageLabel": { "const": "Y" } },
            "required": ["packageLabel"]
          }
        },
        {
          "contains": {
            "properties": { "packageLabel": { "const": "Z" } },
            "required": ["packageLabel"]
          }
        },
        {
          "contains": {
            "properties": { "sourceRole": { "const": "B0" } },
            "required": ["sourceRole"]
          }
        },
        {
          "contains": {
            "properties": { "sourceRole": { "const": "T0" } },
            "required": ["sourceRole"]
          }
        },
        {
          "contains": {
            "properties": { "sourceRole": { "const": "Tfinal" } },
            "required": ["sourceRole"]
          }
        }
      ]
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageLabel",
        "sourceRole",
        "sourcePath",
        "sourceRef",
        "sourceCommit",
        "sourceTree"
      ],
      "properties": {
        "packageLabel": { "enum": ["X", "Y", "Z"] },
        "sourceRole": { "enum": ["B0", "T0", "Tfinal"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "pattern": "^refs/" },
        "sourceCommit": { "$ref": "#/$defs/sha1" },
        "sourceTree": { "$ref": "#/$defs/sha1" }
      }
    }
  }
}
